# Copy to .env and fill in. Do not commit .env (it is gitignored).

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional model overrides (defaults are highest known as of Jan 2026)
# ARCHITECT_MODEL=claude-opus-4-7
# BUILDER_MODEL=o1
# REVIEWER_MODEL=o1
# Use o1-pro, gpt-5, etc. if available

# Optional retry tuning - default 20 attempts, honors API retry-after fully
# MAX_RETRIES=20
